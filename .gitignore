# Cache de documentos da CVM, baixado pelo pipeline
dados/cache/

# Índices e cadastro da CVM, baixados automaticamente (ver README, "Dados").
# dados/ticker_map.csv é versionado: mapa ticker -> código CVM curado à mão.
dados/fca_*.csv
dados/meta_*.csv

# Coleta do RAGAS do TCC 2: documentos e índices ChromaDB recriados a cada
# execução (a saída versionável fica em avaliacao/ragas/coleta_tcc2/)
avaliacao/ragas/runtime/

